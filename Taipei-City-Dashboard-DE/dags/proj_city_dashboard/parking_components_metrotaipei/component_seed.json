      "source": "雙北停車點位整併資料 / 道路施工資料",
      "short_desc": "以空位、價格、容量與施工干擾估算臺北市停車難易度光譜。",
      "long_desc": "停車難易度為 0-100 分，分數越高越難停；公式為 clamp(AvailabilityPenalty + PricePenalty + ConstructionPenalty300m + OnStreetPenalty - CapacityRelief, 0, 100)。各項分數皆正規化，施工干擾採點位 300 公尺內活躍施工件數，大型停車場以連續容量對數給予緩解。地圖以綠、黃、橘、紅呈現容易到困難，近按鈕會依難度與直線距離推薦停車場並估算步行時間。",
      "use_case": "適合輸入或新增目的地地標後，快速找到相對好停、價格與施工風險可接受的停車場。",
      "links": ["https://data.taipei/", "https://tdx.transportdata.tw/"],
      "contributors": ["codex"],
      "query_chart": "WITH construction AS (SELECT wkb_geometry::geometry AS geom FROM public.traffic_todayworks WHERE (cb_ad IS NULL OR cb_ad <= CURRENT_DATE) AND (cd_ad IS NULL OR cd_ad >= CURRENT_DATE) AND wkb_geometry IS NOT NULL), scored AS (SELECT CASE WHEN score < 35 THEN '容易' WHEN score < 55 THEN '普通' WHEN score < 75 THEN '偏難' ELSE '困難' END AS x_axis FROM (SELECT LEAST(100, GREATEST(0, CASE WHEN p.status_label = '空位' THEN LEAST(30, GREATEST(0, COALESCE(NULLIF(p.occupancy_rate::text, '')::numeric, 0.4)) * 30) WHEN p.status_label IN ('已停','不可用') THEN 45 ELSE 38 END + CASE WHEN p.price_value IS NOT NULL THEN LEAST(20, GREATEST(0, NULLIF(p.price_value::text, '')::numeric) / 80 * 20) ELSE CASE p.price_tier WHEN 'premium' THEN 20 WHEN 'high' THEN 15 WHEN 'medium' THEN 8 WHEN 'low' THEN 3 WHEN 'free' THEN 0 ELSE 10 END END + LEAST(15, COALESCE(nc.nearby_construction_count, 0) / 5 * 15) + CASE WHEN p.facility_kind = 'onstreet' THEN 10 ELSE 0 END - CASE WHEN p.facility_kind = 'public_parking' THEN LEAST(10, GREATEST(0, LN((GREATEST(COALESCE(NULLIF(p.capacity_total::text, '')::numeric, 0), 0) + 1)::numeric) / LN(501::numeric) * 10)) ELSE 0 END)) AS score FROM public.tran_parking_supply_points_metrotaipei p CROSS JOIN LATERAL (SELECT COUNT(*)::float AS nearby_construction_count FROM construction c WHERE p.wkb_geometry IS NOT NULL AND c.geom IS NOT NULL AND ST_DWithin(p.wkb_geometry, c.geom, 0.0027)) nc WHERE p.city = 'taipei') calc) SELECT x_axis, COUNT(*)::int AS data FROM scored GROUP BY x_axis ORDER BY array_position(ARRAY['容易','普通','偏難','困難'], x_axis)"
