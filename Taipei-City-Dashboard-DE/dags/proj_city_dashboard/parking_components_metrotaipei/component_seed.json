    {
      "index": "parking_supply_metrotaipei",
      "city": "taipei",
      "query_type": "three_d",
      "map_config_keys": ["supply_taipei_parking", "supply_taipei_onstreet"],
      "map_filter": { "mode": "byParam", "byParam": { "xParam": "type_reference", "yParam": null } },
      "time_from": "current",
      "time_to": null,
      "update_freq": 10,
      "update_freq_unit": "minute",
      "source": "雙北停車點位整併資料",
      "short_desc": "地圖同時顯示停車場與路邊停車格，圓大小表達容量，綠到灰表達已佔程度。",
      "long_desc": "臺北市地圖同時呈現停車場與路邊停車格精確點位；停車場以較大圓突出容量，路邊停車格以較小圓補足單格位置，圖表則比較各類型在不同點位種類中的供給量。",
      "use_case": "適合先看空間上哪裡有大型停車場、哪裡是密集路邊格，再用圖表篩出想看的類型。",
      "links": ["https://data.taipei/", "https://tdx.transportdata.tw/"],
      "contributors": ["codex"],
      "query_chart": "SELECT type_reference AS x_axis, facility_kind_label AS y_axis, SUM(capacity_total)::float AS data FROM public.tran_parking_supply_points_metrotaipei WHERE city = 'taipei' GROUP BY type_reference, facility_kind_label ORDER BY x_axis, array_position(ARRAY['停車場','路邊車格'], facility_kind_label)"
    },
