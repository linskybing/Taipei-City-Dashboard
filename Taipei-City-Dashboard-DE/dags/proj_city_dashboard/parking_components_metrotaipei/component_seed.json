  "query_charts": [
    {
      "index": "parking_supply_metrotaipei",
      "city": "taipei",
      "query_type": "three_d",
      "map_config_keys": ["supply_taipei_parking", "supply_taipei_onstreet"],
      "map_filter": { "mode": "byParam", "byParam": { "xParam": "district", "yParam": "type_reference" } },
      "time_from": "current",
      "time_to": null,
      "update_freq": 10,
      "update_freq_unit": "minute",
      "source": "雙北停車點位整併資料",
      "short_desc": "顯示臺北市停車場與路邊停車格點位供給。",
      "long_desc": "臺北市圖表以行政區與站點類型形成複合長條；進入地圖模式後先點擊行政區長條，才載入對應行政區與類型的停車點位。剩餘空位率低於 0.35 且不為 0 的點以橘色提示。",
      "use_case": "適合比較各行政區的停車場、路邊格位與特殊類型供給，並點擊點位檢查費率、容量與即時狀態。",
      "links": ["https://data.taipei/", "https://tdx.transportdata.tw/"],
      "contributors": ["codex"],
      "query_chart": "SELECT district AS x_axis, type_reference AS y_axis, COUNT(*)::float AS data FROM public.tran_parking_supply_points_metrotaipei WHERE city = 'taipei' AND NULLIF(BTRIM(type_reference), '') IS NOT NULL GROUP BY district, type_reference ORDER BY district, type_reference"
